# QLM OOH — Environment Configuration
# Copy to .env and fill with real values

# Backend API URL (onde o Java se conecta)
API_BASE_URL=http://localhost:5000

# LED Cloud API credentials
LED_CLOUD_API_URL=https://api.ledcloud.com.br
LED_CLOUD_API_KEY=seu-api-key-aqui
LED_CLOUD_ACCOUNT_ID=12345

# Mercado Pago
MERCADO_PAGO_CLIENT_ID=seu-client-id
MERCADO_PAGO_CLIENT_SECRET=seu-client-secret
MERCADO_PAGO_PUBLIC_KEY=sua-public-key
MERCADO_PAGO_ACCESS_TOKEN=seu-access-token

# Camera RTSP
CAMERA_RTSP_URL=rtsp://usuario:senha@192.168.1.100:554/stream1

# Database
DATABASE_URL=sqlite:///var/lib/qlmooh/campaigns.db

# Security
JWT_SECRET=gerar-uma-string-aleatoria-para-jwt
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30
